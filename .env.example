# =============================================================================
# ASSC Open Painting Competition 2026 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Do not commit .env.local to version control.
# All NEXT_PUBLIC_ values are visible to website visitors. Never put secrets here.
# The form links and organiser contact details below are public project defaults.
# =============================================================================

# Google Form — Public URL (the link participants can open directly)
NEXT_PUBLIC_GOOGLE_FORM_URL=https://forms.gle/BW2x9nD8KEf6h8r79

# Google Form — Embed URL (used inside the iframe on the /register page)
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLScOb4I9LX3dbyqfyIYiRnSd554MlsHQSENTkT7L7nZziDj0Vg/viewform?embedded=true

# Registration status: "open" | "coming_soon" | "closed"
NEXT_PUBLIC_REGISTRATION_STATUS=open

# Organiser Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=info@assc.lk
NEXT_PUBLIC_CONTACT_WHATSAPP="+94 71 155 5577"

# Site URL — used for SEO canonical URLs, sitemap, and Open Graph metadata
# Use localhost for development; set your production domain before building for deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
